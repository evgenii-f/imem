# Docker Compose automatically reads this file (as `.env`) for ${VAR}
# substitution in docker-compose.yml. Copy to `.env` and edit to override the
# defaults below. NOTE: this is separate from frontend/.env (Vite build vars).

# Host ports the containers publish. Defaults are the standard ports — override
# only to avoid a collision with something else on your machine.
FRONTEND_PORT=8080
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# Heads-up: the host backend (`imem serve`) reads Qdrant's port from
# imem/config.ini (6333) and does NOT read this file. Changing QDRANT_REST_PORT
# here without also pointing the backend there will split them across two ports.
